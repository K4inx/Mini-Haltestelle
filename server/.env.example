# Kopieren nach .env — .env ist in .gitignore und kommt nie ins Repo.

# RMV Open Data (https://www.rmv.de/s/de/rmv-open-data). Leer = Transitous wird genutzt.
RMV_API_KEY=

# Kontakt im User-Agent für Transitous (Pflicht laut Nutzungsrichtlinie): Website oder E-Mail.
TRANSITOUS_CONTACT=https://kainx.de

# „Jetzt los"-Push: URL eines Webhooks (z. B. n8n), bekommt JSON per POST. Leer = aus.
NOTIFY_WEBHOOK_URL=

LOG_LEVEL=INFO
